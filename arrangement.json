{
  "bgm": "stems/bgm/instrumental.wav",
  "output": "build/mix_v3_final.wav",
  "crossfade_sec": 0.3,
  "master_gain_db": 0,

  "video": {
    "audio": "build/mix_v3_final.wav",
    "output": "build/movie_v2.mp4",
    "resolution": "1920x1080",
    "fps": 30,
    "fontsize": 120,
    "fontfile": "/System/Library/Fonts/ヒラギノ角ゴシック W6.ttc",
    "dim_level": 60
  },

  "vocalists": {
    "original": { "file": "stems/vocals/01_original.wav", "gain_db": 0, "pan": 0.0,   "display": "ミク" },
    "instant":  { "file": "stems/vocals/02_instant.wav",  "gain_db": 0, "pan": -0.35, "display": "レン" },
    "second":   { "file": "stems/vocals/03_2hitome.wav",  "gain_db": 0, "pan": 0.35,  "display": "リン" }
  },

  "sections": [
    { "label": "Aメロ1", "start": 7.5,   "end": 30.0,  "vocals": ["original"] },
    { "label": "Bメロ1", "start": 30.0,  "end": 52.0,  "vocals": ["instant"] },
    { "label": "サビ1",  "start": 52.0,  "end": 94.0,  "vocals": ["original", "instant", "second"], "gain_db": -4 },
    { "label": "Aメロ2", "start": 96.0,  "end": 116.0, "vocals": ["second"] },
    { "label": "Bメロ2", "start": 118.0, "end": 130.5, "vocals": ["second"] },
    { "label": "サビ2",  "start": 130.5, "end": 187.5, "vocals": ["original", "instant", "second"], "gain_db": -4 },
    { "label": "ラスサビ", "start": 210.0, "end": 261.0, "vocals": ["original", "instant", "second"], "gain_db": -4 }
  ],

  "_note": "start/end は秒。vocals に並べた人数だけ重なる。サビは3人ユニゾン。pan で左右に分離(-1左/0中央/1右)し3人重ねの濁りを回避。区間は analysis/vocal_sections.csv の解析推定ベースの暫定値で、試聴して微調整する。"
}
